# Copy to .env and edit. Every value is optional.

# SAFEGUARD_SECRET_KEY=            # auto-generated into instance/secret_key if unset
# SAFEGUARD_ADMIN_USERNAME=admin
# SAFEGUARD_ADMIN_PASSWORD=        # if unset, a random one is printed once on first run
# SAFEGUARD_COOKIE_SECURE=true     # enable when served over HTTPS
# SAFEGUARD_DATABASE_URL=sqlite:///instance/safeguard.db

# Detection tuning
# SAFEGUARD_VIOLENCE_THRESHOLD=0.20
# SAFEGUARD_PERSISTENT_SECONDS=12
# SAFEGUARD_ALERT_COOLDOWN=20
# SAFEGUARD_ANALYSIS_FPS=6
# SAFEGUARD_FACE_MATCH_THRESHOLD=0.40

# Privacy
# SAFEGUARD_RETENTION_DAYS=30
# SAFEGUARD_AUTOSTART_CAMERAS=false

# Notifications (any combination)
# SAFEGUARD_WEBHOOK_URL=https://hooks.example.com/...
# SAFEGUARD_TELEGRAM_BOT_TOKEN=
# SAFEGUARD_TELEGRAM_CHAT_ID=
# SAFEGUARD_SMTP_HOST=smtp.example.com
# SAFEGUARD_SMTP_USER=
# SAFEGUARD_SMTP_PASSWORD=
# SAFEGUARD_ALERT_EMAIL_TO=
